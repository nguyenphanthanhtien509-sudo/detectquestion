# Copy this file to .env and set credentials in the local file only.
ENABLE_REASONING=true
REASONING_EFFORT=high

# The extension only receives this local bridge configuration. Models and
# provider credentials are read by the backend process only.
ORCHESTRATOR_URL=http://127.0.0.1:8787
ORCHESTRATOR_AUTH_TOKEN=replace-with-a-short-lived-user-token
AI_PROVIDER_API_KEY=your-backend-only-provider-key
# Optional USB gateway. In esp32 mode provider credentials and TLS CA are
# provisioned on the board; both AI and desktop licensing travel through USB.
# AI_TRANSPORT=esp32
# ESP32_SERIAL_PORT=COM7
ORCHESTRATOR_MODELS=gemini-3.8-flash,gemini-2.5-flash,gemini-2.5-flash-lite
# Alt+M/U/K use this one unverified model; independent from consensus slots.
ORCHESTRATOR_EMERGENCY_MODEL=gemini-2.5-flash-lite
# Gemini-only Backward pool: first model is primary, the remaining four are
# sequential recovery fallbacks. It shares AI_PROVIDER_API_KEY with Forward.
ORCHESTRATOR_BACKWARD_GEMINI_MODELS=["gemini-3.6-flash","gemini-3.7-flash","gemini-3.5-flash","gemini-2.5-flash","gemini-3.1-flash-lite"]
ORCHESTRATOR_DEBUG_LOGGING=false
# Detailed backward evidence is emitted only when this and debug logging are true.
ORCHESTRATOR_DETAILED_BACKWARD_LOGGING=false

# All stage budgets are interpreted under this shared request deadline.
# Leave unset to use the tested defaults in orchestrator/lib/fallback.js.
# ORCHESTRATOR_GLOBAL_TIMEOUT_MS=45000
# Alt+M uses one display-only model and may wait longer than the 12s parallel-slot default.
# ORCHESTRATOR_SINGLE_MODEL_TIMEOUT_MS=30000
# ORCHESTRATOR_BACKWARD_PRIMARY_TIMEOUT_MS=7000
# ORCHESTRATOR_BACKWARD_BACKUP_TIMEOUT_MS=5000
# ORCHESTRATOR_BACKWARD_MAX_BACKUPS=4
# ORCHESTRATOR_SCHEMA_REPAIR_PRIMARY_TIMEOUT_MS=8000
# ORCHESTRATOR_SCHEMA_REPAIR_BACKUP_TIMEOUT_MS=8000
# ORCHESTRATOR_SCHEMA_REPAIR_MAX_BACKUPS=1
# JSON-lines request/pipeline/result logs. No credentials or image bytes are logged.
ORCHESTRATOR_FILE_LOGGING=true
# Required for the account-gated desktop build. These are public Supabase
# values; never put SUPABASE_SERVICE_ROLE_KEY in this file or in the EXE.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional absolute or relative folder. Default: orchestrator/logs
# ORCHESTRATOR_LOG_DIR=orchestrator/logs
